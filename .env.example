# ---- Wendy Fest configuration ----
PORT=3000
# Public URL used inside SMS + QR codes. On event day: the laptop's LAN IP or your domain.
BASE_URL=http://localhost:3000

KIOSK_PIN=2468
ADMIN_PIN=1357

# Roast Me (Claude vision). Without a key the booth uses the offline fallback roast bank.
ANTHROPIC_API_KEY=
ROAST_MODEL=claude-opus-5-5
ROAST_EFFORT=medium

# SMS: console | notifylk | shoutout | dialog | http
SMS_PROVIDER=console
SMS_SENDER_ID=Wendys
NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
SHOUTOUT_API_KEY=
DIALOG_SMS_URL=
DIALOG_SMS_USER=
DIALOG_SMS_PASS=
SMS_HTTP_URL=
SMS_HTTP_AUTH=

# Scream & Win defaults (also editable live in /admin)
SCREAM_THRESHOLD=70
SCREAM_LOUD_WEIGHT=0.6
SCREAM_ACC_WEIGHT=0.4
SCREAM_DB_FLOOR=-42
SCREAM_DB_CEIL=-6
SCREAM_ATTEMPTS=1
ROAST_ATTEMPTS=1

# What the coupon unlocks – confirm with client before launch
COUPON_VALUE_LABEL=10% OFF your next Wendy's order
COUPON_TERMS=Valid at Wendy's Sri Lanka outlets during the launch period. One use per code.

# OTP (SMS verification before the pass is issued)
OTP_DIGITS=4
OTP_TTL_SEC=120
OTP_RESEND_SEC=30
